#!/usr/bin/env fontforge

# Create new font
New()

# Set font properties
SetFontNames("MyCalligraphyFont", "MyCalligraphyFont", "My Calligraphy Font")

# Define file mappings

# Import a.svg
if (FileAccess("C:/Users/AdityaPatidar/Documents/Calligraphy_Approaches/output_class_2_svg/a.svg", 0) == 0)
    Select(0x61)
    Import("C:/Users/AdityaPatidar/Documents/Calligraphy_Approaches/output_class_2_svg/a.svg")
    SetLBearing(50)
    SetRBearing(50)
    Print("Imported a.svg")
else
    Print("File not found: a.svg")
endif

